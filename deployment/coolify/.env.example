# Secrets for Coolify's "Environment Variables" tab. Reference list only.

# Generate with: openssl rand -base64 48
POSTGRES_PASSWORD=

# Public domain Coolify serves the app on (no scheme), e.g. manfrod.example.com
PHX_HOST=

# Inngest (self-hosted). Generate each with: openssl rand -hex 32
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Must stay the same as the old deployment, or stored Linear keys and tokens can't be decrypted
LINEAR_ENCRYPTION_KEY=

# Linear OAuth app (Settings → API → OAuth applications), redirect URI https://$PHX_HOST/linear/callback
LINEAR_CLIENT_ID=
LINEAR_CLIENT_SECRET=

# Optional: signs web sessions. Derived from LINEAR_ENCRYPTION_KEY when empty.
BETTER_AUTH_SECRET=

# Slack app: Event Subscriptions + Interactivity + Slash Commands Request URL
# is https://$PHX_HOST/eve/v1/slack
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Optional integrations - leave blank to disable the feature
OPENROUTER_API_KEY=
TYPESAFE_AI_API_KEY=
VOYAGE_API_KEY=
BRAVE_SEARCH_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
HOLIDAY_CALENDAR_ID=
KALAFIORNIA_OFFICE_ACCESS_API_KEY=
