{
  "name": "manfrod",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "DISABLE_CRONS=${DISABLE_CRONS:-1} node scripts/with-env.mjs next dev --port ${PORT:-35233}",
    "dev:agent": "node scripts/with-env.mjs eve dev",
    "build": "eve build && next build",
    "start": "node scripts/migrate.mjs && next start --port ${PORT:-35233}",
    "db:pull": "node scripts/with-env.mjs node scripts/db-pull.mjs",
    "db:migrate": "node scripts/with-env.mjs node scripts/migrate.mjs",
    "db:verify": "node scripts/with-env.mjs tsx scripts/verify-data.ts",
    "eval:memory": "node scripts/with-env.mjs tsx scripts/eval-memory.ts",
    "slack:export": "node scripts/with-env.mjs tsx scripts/slack-export.ts",
    "desk-map": "node scripts/with-env.mjs tsx scripts/generate-desk-map.ts",
    "typecheck": "tsc",
    "test": "vitest run",
    "check": "tsc && vitest run",
    "dev:slack": "node scripts/with-env.mjs node scripts/dev-slack.mjs"
  },
  "dependencies": {
    "@ai-sdk/typesafe-ai": "3.0.26",
    "@base-ui/react": "^1.9.0",
