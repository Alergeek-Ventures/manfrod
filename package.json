    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "@tanstack/react-table": "^9.3.1",
    "ai": "7.0.150",
    "better-auth": "1.7.12",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.5.0",
    "croner": "10.0.1",
    "cytoscape": "3.34.4",
    "drizzle-orm": "0.45.4",
    "eve": "0.83.0",
    "inngest": "4.26.0",
    "just-bash": "3.6.0",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.8.0",
    "shadcn": "^4.22.1",
    "sharp": "0.35.5",
