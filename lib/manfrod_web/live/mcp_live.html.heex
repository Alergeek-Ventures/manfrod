<Layouts.app flash={@flash} current_scope={@current_scope}>
  <Layouts.nav current={:mcp} current_scope={@current_scope} />
  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-100">MCP connections</h1>
      <p class="text-sm text-gray-400 mt-1">
        Connect your own accounts so Manfrod can use them when it talks to you — in DMs or in a
        thread started with you in a channel. Connections are per-person: connecting Linear here
        only gives the agent access to your Linear, not anyone else's.
      </p>
    </div>

    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">Built-in</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <%= for provider <- @builtin_providers do %>
        <.provider_card provider={provider} conn={Map.get(@mcp_connections, provider.id)} />
      <% end %>
    </div>

    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">Custom</h2>
    <p class="text-xs text-gray-500 mb-3">
      Add any MCP server by URL. Manfrod tries to auto-detect its name and logo — if it can't,
      you can name it yourself.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= for provider <- @custom_providers do %>
        <.provider_card
          provider={provider}
          conn={Map.get(@mcp_connections, provider.id)}
          deletable
        />
      <% end %>

      <%= if @show_add_form do %>
        <div class="p-4 bg-gray-800 rounded-xl border border-gray-700 flex flex-col gap-3">
          <h3 class="text-sm font-semibold text-gray-100">Add custom MCP server</h3>
          <div>
            <label class="block text-xs text-gray-400 mb-1">MCP URL</label>
            <input
              type="text"
              placeholder="https://mcp.example.com/mcp"
              value={@add_form["url"]}
              phx-blur="update_add_form"
              phx-value-field="url"
              class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Name (optional, auto-detected if left blank)</label>
            <input
              type="text"
              placeholder="e.g. Acme MCP"
              value={@add_form["name"]}
              phx-blur="update_add_form"
              phx-value-field="name"
              class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div class="flex gap-3">
            <button
              phx-click="save_custom_provider"
              disabled={@adding}
              class="px-3 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white rounded-lg"
            >
              <%= if @adding, do: "Adding…", else: "Add" %>
            </button>
            <button
              phx-click="toggle_add_form"
              class="px-3 py-1.5 text-xs font-medium text-gray-400 hover:text-gray-200"
            >
              Cancel
            </button>
          </div>
        </div>
      <% else %>
        <button
          phx-click="toggle_add_form"
          class="p-4 rounded-xl border border-dashed border-gray-700 hover:border-indigo-500 hover:bg-gray-800/50 flex items-center justify-center gap-2 text-gray-500 hover:text-indigo-400 transition-colors min-h-[92px]"
        >
          <svg viewBox="0 0 20 20" class="w-5 h-5" fill="currentColor">
            <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1z" />
          </svg>
          <span class="text-sm font-medium">Add MCP server</span>
        </button>
      <% end %>
    </div>
  </div>
</Layouts.app>
