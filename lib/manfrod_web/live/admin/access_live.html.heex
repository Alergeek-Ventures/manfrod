<Layouts.app flash={@flash} current_scope={@current_scope}>
  <Layouts.nav current={:admin} current_scope={@current_scope} />
  <div class="max-w-6xl mx-auto p-6">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-100">Access Panel</h1>
    <p class="text-sm text-gray-400 mt-1">Manage projects, channels, and memberships</p>
  </div>

  <%!-- Tabs --%>
  <div class="flex gap-1 mb-6 border-b border-gray-700">
    <button
      phx-click="switch_tab"
      phx-value-tab="channels"
      class={[
        "px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors",
        if(@tab == "channels",
          do: "border-indigo-500 text-indigo-400",
          else: "border-transparent text-gray-400 hover:text-gray-200"
        )
      ]}
    >
      Channels (<%= length(@channels) %>)
    </button>
    <button
      phx-click="switch_tab"
      phx-value-tab="projects"
      class={[
        "px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors",
        if(@tab == "projects",
          do: "border-indigo-500 text-indigo-400",
          else: "border-transparent text-gray-400 hover:text-gray-200"
        )
      ]}
    >
      Projects (<%= length(@projects) %>)
    </button>
    <button
      phx-click="switch_tab"
      phx-value-tab="members"
      class={[
        "px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors",
        if(@tab == "members",
          do: "border-indigo-500 text-indigo-400",
          else: "border-transparent text-gray-400 hover:text-gray-200"
        )
      ]}
    >
      Members (<%= length(@members) %>)
    </button>
    <button
      phx-click="switch_tab"
      phx-value-tab="vacations"
      class={[
        "px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors",
        if(@tab == "vacations",
          do: "border-indigo-500 text-indigo-400",
          else: "border-transparent text-gray-400 hover:text-gray-200"
        )
      ]}
    >
      Vacations (<%= length(@vacations) %>)
    </button>
    <button
      phx-click="switch_tab"
      phx-value-tab="cron"
      class={[
        "px-4 py-2 text-sm font-medium border-b-2 -mb-px transition-colors",
        if(@tab == "cron",
          do: "border-indigo-500 text-indigo-400",
          else: "border-transparent text-gray-400 hover:text-gray-200"
        )
      ]}
    >
      Cron (<%= length(@cron_rows) %>)
    </button>
  </div>

  <%!-- Channels tab --%>
  <%= if @tab == "channels" do %>
    <%= if @channels == [] do %>
      <p class="text-gray-500 text-sm">No mapped channels. Send a message in the channel — auto-detection will add it automatically.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wider">
              <th class="pb-3 pr-4">Channel</th>
              <th class="pb-3 pr-4">ID</th>
              <th class="pb-3 pr-4">Project</th>
              <th class="pb-3 pr-4">Client ID</th>
              <th class="pb-3 pr-4">Status</th>
              <th class="pb-3 pr-4">Source</th>
              <th class="pb-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800">
            <%= for ch <- @channels do %>
              <tr class="text-gray-300">
                <td class="py-3 pr-4 font-mono text-xs">
                  <%= if ch.slack_channel_name, do: "##{ch.slack_channel_name}", else: "—" %>
                </td>
                <td class="py-3 pr-4 font-mono text-xs text-gray-500">
                  <%= ch.slack_channel_id %>
                </td>
                <td class="py-3 pr-4 text-xs">
                  <%= ch.project_slug || "—" %>
                </td>
                <td class="py-3 pr-4 text-xs">
                  <%= ch.client_id || "—" %>
                </td>
                <td class="py-3 pr-4">
                  <span class={[
                    "px-2 py-0.5 rounded text-xs font-medium",
                    if(ch.status == "active",
                      do: "bg-green-900/50 text-green-400",
                      else: "bg-yellow-900/50 text-yellow-400"
                    )
                  ]}>
                    <%= ch.status %>
                  </span>
                </td>
                <td class="py-3 pr-4 text-xs text-gray-500">
                  <%= ch.source %>
                </td>
                <td class="py-3 flex gap-2 justify-end">
                  <%= if ch.status == "active" do %>
                    <button
                      phx-click="deactivate_mapping"
                      phx-value-id={ch.id}
                      class="text-xs text-yellow-500 hover:text-yellow-300"
                    >
                      Deactivate
                    </button>
                  <% else %>
                    <button
                      phx-click="activate_mapping"
                      phx-value-id={ch.id}
                      class="text-xs text-green-500 hover:text-green-300"
                    >
                      Activate
                    </button>
                  <% end %>
                  <button
                    phx-click="delete_mapping"
                    phx-value-id={ch.id}
                    data-confirm="Delete this mapping?"
                    class="text-xs text-red-500 hover:text-red-300"
                  >
                    Delete
                  </button>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <%!-- Projects tab --%>
  <%= if @tab == "projects" do %>
    <div class="mb-4 flex justify-end">
      <button
        phx-click="toggle_add_project"
        class="px-3 py-1.5 text-sm bg-indigo-600 hover:bg-indigo-500 text-white rounded"
      >
        <%= if @show_add_project, do: "Cancel", else: "Add project" %>
      </button>
    </div>

    <%= if @show_add_project do %>
      <div class="mb-6 p-4 bg-gray-800 rounded border border-gray-700">
        <h3 class="text-sm font-medium text-gray-200 mb-3">New project</h3>
        <div class="flex gap-3 items-end">
          <div>
            <label class="block text-xs text-gray-400 mb-1">Slug</label>
            <input
              type="text"
              placeholder="e.g. client-abc"
              value={@add_project_form["slug"]}
              phx-blur="update_add_project"
              phx-value-field="slug"
              class="bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Name</label>
            <input
              type="text"
              placeholder="e.g. Client ABC Inc."
              value={@add_project_form["name"]}
              phx-blur="update_add_project"
              phx-value-field="name"
              class="bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
          <button
            phx-click="save_project"
            class="px-3 py-1.5 text-sm bg-green-700 hover:bg-green-600 text-white rounded"
          >
            Save
          </button>
        </div>
      </div>
    <% end %>

    <%= if @projects == [] do %>
      <p class="text-gray-500 text-sm">No projects.</p>
    <% else %>
      <table class="w-full text-sm text-left">
        <thead>
          <tr class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wider">
            <th class="pb-3 pr-4">Slug</th>
            <th class="pb-3 pr-4">Name</th>
            <th class="pb-3 pr-4 text-right">Channels</th>
            <th class="pb-3 text-right">Members</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <%= for p <- @projects do %>
            <tr class="text-gray-300">
              <td class="py-3 pr-4 font-mono text-xs"><%= p.slug %></td>
              <td class="py-3 pr-4"><%= p.name %></td>
              <td class="py-3 pr-4 text-right text-gray-400"><%= p.channel_count %></td>
              <td class="py-3 text-right text-gray-400"><%= p.member_count %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <%!-- Members tab --%>
  <%= if @tab == "members" do %>
    <%= if @members == [] do %>
      <p class="text-gray-500 text-sm">No memberships.</p>
    <% else %>
      <table class="w-full text-sm text-left">
        <thead>
          <tr class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wider">
            <th class="pb-3 pr-4">User</th>
            <th class="pb-3 pr-4">Slack ID</th>
            <th class="pb-3">Projects</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          <%= for m <- @members do %>
            <tr class="text-gray-300">
              <td class="py-3 pr-4"><%= m.user_name || "—" %></td>
              <td class="py-3 pr-4 font-mono text-xs text-gray-500"><%= m.user_slack_id %></td>
              <td class="py-3 text-xs text-gray-400">
                <%= Enum.map_join(m.memberships, ", ", fn ms -> "#{ms.project_name} (#{ms.project_slug})" end) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  <% end %>

  <%!-- Vacations tab --%>
  <%= if @tab == "vacations" do %>
    <div class="mb-6 p-4 bg-gray-800 rounded border border-gray-700">
      <h3 class="text-sm font-medium text-gray-200 mb-3">Add vacation</h3>
      <div class="grid grid-cols-1 md:grid-cols-5 gap-3 items-end">
        <div>
          <label class="block text-xs text-gray-400 mb-1">Person</label>
          <select
            name="user_id"
            phx-change="update_vacation_form"
            class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 focus:outline-none focus:border-indigo-500"
          >
            <option value="">Select...</option>
            <%= for user <- @users do %>
              <option value={user.id} selected={@vacation_form["user_id"] == user.id}>
                <%= user.name || user.email || user.slack_id %>
              </option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">From</label>
          <input
            type="date"
            name="start_date"
            value={@vacation_form["start_date"]}
            phx-change="update_vacation_form"
            class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 focus:outline-none focus:border-indigo-500"
          />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">To</label>
          <input
            type="date"
            name="end_date"
            value={@vacation_form["end_date"]}
            phx-change="update_vacation_form"
            class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 focus:outline-none focus:border-indigo-500"
          />
        </div>
        <div>
          <label class="block text-xs text-gray-400 mb-1">Description</label>
          <input
            type="text"
            name="note"
            value={@vacation_form["note"]}
            phx-change="update_vacation_form"
            placeholder="vacation"
            class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
          />
        </div>
        <button
          phx-click="save_vacation"
          class="px-3 py-1.5 text-sm bg-green-700 hover:bg-green-600 text-white rounded"
        >
          Save
        </button>
      </div>
      <p class="text-xs text-gray-500 mt-3">Vacations are saved as facts with access <code>["internal", "external/all"]</code>.</p>
    </div>

    <%= if @vacations == [] do %>
      <p class="text-gray-500 text-sm">No vacations/absences saved.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wider">
              <th class="pb-3 pr-4">Person</th>
              <th class="pb-3 pr-4">Key</th>
              <th class="pb-3 pr-4">Value</th>
              <th class="pb-3 pr-4">Access</th>
              <th class="pb-3 pr-4">Updated</th>
              <th class="pb-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800">
            <%= for vacation <- @vacations do %>
              <tr class="text-gray-300 align-top">
                <td class="py-3 pr-4">
                  <div><%= vacation.user_name || "—" %></div>
                  <div class="text-xs text-gray-500"><%= vacation.user_slack_id || "system" %></div>
                </td>
                <td class="py-3 pr-4 font-mono text-xs text-gray-500"><%= vacation.key %></td>
                <td class="py-3 pr-4 min-w-80">
                  <%= if @editing_vacation_id == vacation.id do %>
                    <textarea
                      phx-change="update_vacation_value"
                      name="value"
                      class="w-full min-h-20 bg-gray-700 border border-gray-600 rounded px-3 py-2 text-sm text-gray-100 focus:outline-none focus:border-indigo-500"
                    ><%= @editing_vacation_value %></textarea>
                  <% else %>
                    <div class="whitespace-pre-wrap"><%= vacation.value %></div>
                  <% end %>
                </td>
                <td class="py-3 pr-4 font-mono text-xs text-gray-500"><%= Enum.join(vacation.access, ", ") %></td>
                <td class="py-3 pr-4 text-xs text-gray-500"><%= vacation.updated_at || vacation.inserted_at %></td>
                <td class="py-3 flex gap-2 justify-end">
                  <%= if @editing_vacation_id == vacation.id do %>
                    <button
                      phx-click="save_vacation_edit"
                      phx-value-id={vacation.id}
                      class="text-xs text-green-500 hover:text-green-300"
                    >
                      Save
                    </button>
                    <button
                      phx-click="cancel_edit_vacation"
                      class="text-xs text-gray-400 hover:text-gray-200"
                    >
                      Cancel
                    </button>
                  <% else %>
                    <button
                      phx-click="edit_vacation"
                      phx-value-id={vacation.id}
                      class="text-xs text-indigo-400 hover:text-indigo-300"
                    >
                      Edit
                    </button>
                    <button
                      phx-click="delete_vacation"
                      phx-value-id={vacation.id}
                      data-confirm="Delete this vacation?"
                      class="text-xs text-red-500 hover:text-red-300"
                    >
                      Delete
                    </button>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>

  <%!-- Cron tab --%>
  <%= if @tab == "cron" do %>
    <p class="text-xs text-gray-500 mb-4">
      All scheduled tasks: cron skills from the frontmatter (not editable from the panel) and recurring reminders added by users (via the agent, e.g. "do this every day at 8").
    </p>

    <%= if @cron_rows == [] do %>
      <p class="text-gray-500 text-sm">No scheduled tasks.</p>
    <% else %>
      <div class="overflow-x-auto">
        <table class="w-full text-sm text-left">
          <thead>
            <tr class="border-b border-gray-700 text-gray-400 text-xs uppercase tracking-wider">
              <th class="pb-3 pr-4">Name</th>
              <th class="pb-3 pr-4">Type</th>
              <th class="pb-3 pr-4">Cron</th>
              <th class="pb-3 pr-4">Timezone</th>
              <th class="pb-3 pr-4">Owner</th>
              <th class="pb-3 pr-4">Description</th>
              <th class="pb-3 pr-4">Status</th>
              <th class="pb-3"></th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-800">
            <%= for row <- @cron_rows do %>
              <tr class="text-gray-300 align-top">
                <td class="py-3 pr-4 font-mono text-xs"><%= row.name %></td>
                <td class="py-3 pr-4">
                  <span class={[
                    "px-2 py-0.5 rounded text-xs font-medium",
                    if(row.type == :skill,
                      do: "bg-purple-900/50 text-purple-300",
                      else: "bg-blue-900/50 text-blue-300"
                    )
                  ]}>
                    <%= if row.type == :skill, do: "Skill", else: "User" %>
                  </span>
                </td>
                <td class="py-3 pr-4">
                  <%= if editing?(@editing_cron_id, row) do %>
                    <input
                      type="text"
                      value={@editing_cron_form["cron"]}
                      phx-blur="update_cron_form"
                      phx-value-field="cron"
                      class="w-36 bg-gray-700 border border-gray-600 rounded px-2 py-1 text-xs font-mono text-gray-100 focus:outline-none focus:border-indigo-500"
                    />
                  <% else %>
                    <span class="font-mono text-xs"><%= row.cron %></span>
                  <% end %>
                </td>
                <td class="py-3 pr-4 text-xs">
                  <%= if editing?(@editing_cron_id, row) do %>
                    <input
                      type="text"
                      value={@editing_cron_form["timezone"]}
                      phx-blur="update_cron_form"
                      phx-value-field="timezone"
                      class="w-32 bg-gray-700 border border-gray-600 rounded px-2 py-1 text-xs text-gray-100 focus:outline-none focus:border-indigo-500"
                    />
                  <% else %>
                    <%= row.timezone %>
                  <% end %>
                </td>
                <td class="py-3 pr-4 text-xs">
                  <div><%= row.owner_name || "—" %></div>
                  <%= if row.owner_slack_id do %>
                    <div class="text-gray-500 font-mono"><%= row.owner_slack_id %></div>
                  <% end %>
                  <%= if row.channel do %>
                    <div class="text-gray-500 font-mono">channel: <%= row.channel %></div>
                  <% end %>
                </td>
                <td class="py-3 pr-4 text-xs text-gray-400 max-w-xs">
                  <%= if editing?(@editing_cron_id, row) do %>
                    <textarea
                      phx-blur="update_cron_form"
                      phx-value-field="instructions"
                      class="w-full min-h-24 bg-gray-700 border border-gray-600 rounded px-2 py-1 text-xs text-gray-100 focus:outline-none focus:border-indigo-500"
                    ><%= @editing_cron_form["instructions"] %></textarea>
                  <% else %>
                    <div class="whitespace-pre-wrap"><%= row.detail %></div>
                  <% end %>
                </td>
                <td class="py-3 pr-4">
                  <%= if row.type == :skill do %>
                    <span class="text-xs text-gray-500">—</span>
                  <% else %>
                    <button
                      phx-click="toggle_cron_enabled"
                      phx-value-id={row.id}
                      class={[
                        "px-2 py-0.5 rounded text-xs font-medium",
                        if(row.enabled,
                          do: "bg-green-900/50 text-green-400 hover:bg-green-900/80",
                          else: "bg-yellow-900/50 text-yellow-400 hover:bg-yellow-900/80"
                        )
                      ]}
                    >
                      <%= if row.enabled, do: "enabled", else: "disabled" %>
                    </button>
                  <% end %>
                </td>
                <td class="py-3 flex gap-2 justify-end">
                  <%= if row.type == :user do %>
                    <%= if editing?(@editing_cron_id, row) do %>
                      <button
                        phx-click="save_cron_edit"
                        phx-value-id={row.id}
                        class="text-xs text-green-500 hover:text-green-300"
                      >
                        Save
                      </button>
                      <button
                        phx-click="cancel_edit_cron"
                        class="text-xs text-gray-400 hover:text-gray-200"
                      >
                        Cancel
                      </button>
                    <% else %>
                      <button
                        phx-click="edit_cron"
                        phx-value-id={row.id}
                        class="text-xs text-indigo-400 hover:text-indigo-300"
                      >
                        Edit
                      </button>
                      <button
                        phx-click="delete_cron"
                        phx-value-id={row.id}
                        data-confirm="Delete this cron?"
                        class="text-xs text-red-500 hover:text-red-300"
                      >
                        Delete
                      </button>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  <% end %>
  </div>
</Layouts.app>
