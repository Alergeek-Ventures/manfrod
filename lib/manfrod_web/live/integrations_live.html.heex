<Layouts.app flash={@flash} current_scope={@current_scope}>
  <Layouts.nav current={:integrations} current_scope={@current_scope} />
  <div class="max-w-4xl mx-auto p-6">
    <div class="mb-6">
      <h1 class="text-2xl font-bold text-gray-100">Integrations</h1>
      <p class="text-sm text-gray-400 mt-1">
        Connect your own accounts so Manfrod can use them when it talks to you — in DMs or in a
        thread started with you in a channel. Connections are per-person: connecting Linear here
        only gives the agent access to your Linear, not anyone else's.
      </p>
    </div>

    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">MCP · Built-in</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
      <%= for provider <- @builtin_providers do %>
        <.provider_card provider={provider} conn={Map.get(@mcp_connections, provider.id)} />
      <% end %>
    </div>

    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3">MCP · Custom</h2>
    <p class="text-xs text-gray-500 mb-3">
      Add any MCP server by URL. Manfrod tries to auto-detect its name and logo — if it can't,
      you can name it yourself.
    </p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <%= for provider <- @custom_providers do %>
        <.provider_card
          provider={provider}
          conn={Map.get(@mcp_connections, provider.id)}
          deletable
        />
      <% end %>

      <%= if @show_add_form do %>
        <div class="p-4 bg-gray-800 rounded-xl border border-gray-700 flex flex-col gap-3">
          <h3 class="text-sm font-semibold text-gray-100">Add custom MCP server</h3>
          <div>
            <label class="block text-xs text-gray-400 mb-1">MCP URL</label>
            <input
              type="text"
              placeholder="https://mcp.example.com/mcp"
              value={@add_form["url"]}
              phx-blur="update_add_form"
              phx-value-field="url"
              class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div>
            <label class="block text-xs text-gray-400 mb-1">Name (optional, auto-detected if left blank)</label>
            <input
              type="text"
              placeholder="e.g. Acme MCP"
              value={@add_form["name"]}
              phx-blur="update_add_form"
              phx-value-field="name"
              class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
            />
          </div>
          <div class="flex gap-3">
            <button
              phx-click="save_custom_provider"
              disabled={@adding}
              class="px-3 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white rounded-lg"
            >
              <%= if @adding, do: "Adding…", else: "Add" %>
            </button>
            <button
              phx-click="toggle_add_form"
              class="px-3 py-1.5 text-xs font-medium text-gray-400 hover:text-gray-200"
            >
              Cancel
            </button>
          </div>
        </div>
      <% else %>
        <button
          phx-click="toggle_add_form"
          class="p-4 rounded-xl border border-dashed border-gray-700 hover:border-indigo-500 hover:bg-gray-800/50 flex items-center justify-center gap-2 text-gray-500 hover:text-indigo-400 transition-colors min-h-[92px]"
        >
          <svg viewBox="0 0 20 20" class="w-5 h-5" fill="currentColor">
            <path d="M10 4a1 1 0 0 1 1 1v4h4a1 1 0 1 1 0 2h-4v4a1 1 0 1 1-2 0v-4H5a1 1 0 1 1 0-2h4V5a1 1 0 0 1 1-1z" />
          </svg>
          <span class="text-sm font-medium">Add MCP server</span>
        </button>
      <% end %>
    </div>

    <h2 class="text-xs font-semibold uppercase tracking-wider text-gray-500 mb-3 mt-8">
      Integrations
    </h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
      <div class="p-4 bg-gray-800 rounded-xl border border-gray-700 flex flex-col gap-4">
        <div class="flex items-center gap-3">
          <div class="w-10 h-10 rounded-lg bg-gray-700 flex items-center justify-center">
            <img src="/images/mcp/kalafiornia.svg" class="w-7 h-7 object-contain" />
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-semibold text-gray-100 truncate">Kalafiornia App</h3>
            <%= if @kalafiornia_connection do %>
              <span class="inline-flex items-center gap-1 text-xs text-green-400">
                <span class="w-1.5 h-1.5 rounded-full bg-green-400"></span>
                Connected as {@kalafiornia_connection.email}
              </span>
            <% else %>
              <span class="text-xs text-gray-500">Not connected</span>
            <% end %>
          </div>
        </div>

        <%= case @kalafiornia_step do %>
          <% :status -> %>
            <div class="flex items-center justify-between gap-4">
              <button
                phx-click="kalafiornia_start_login"
                class="inline-block w-fit px-3 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 text-white rounded-lg"
              >
                <%= if @kalafiornia_connection, do: "Reconnect", else: "Connect" %>
              </button>
              <%= if @kalafiornia_connection do %>
                <button
                  phx-click="kalafiornia_disconnect"
                  data-confirm="Disconnect Kalafiornia?"
                  class="text-xs font-medium text-red-500 hover:text-red-300"
                >
                  Disconnect
                </button>
              <% end %>
            </div>
          <% :email -> %>
            <div class="flex flex-col gap-3">
              <div>
                <label class="block text-xs text-gray-400 mb-1">Email</label>
                <input
                  type="email"
                  value={@kalafiornia_email}
                  phx-blur="kalafiornia_update_email"
                  class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
                />
              </div>
              <div class="flex gap-3">
                <button
                  phx-click="kalafiornia_send_pin"
                  disabled={@kalafiornia_sending}
                  class="px-3 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white rounded-lg"
                >
                  <%= if @kalafiornia_sending, do: "Sending…", else: "Send PIN" %>
                </button>
                <button
                  phx-click="kalafiornia_cancel"
                  class="px-3 py-1.5 text-xs font-medium text-gray-400 hover:text-gray-200"
                >
                  Cancel
                </button>
              </div>
            </div>
          <% :pin -> %>
            <div class="flex flex-col gap-3">
              <div>
                <label class="block text-xs text-gray-400 mb-1">
                  PIN (sent to {@kalafiornia_email})
                </label>
                <input
                  type="text"
                  inputmode="numeric"
                  value={@kalafiornia_pin}
                  phx-blur="kalafiornia_update_pin"
                  placeholder="1234"
                  class="w-full bg-gray-700 border border-gray-600 rounded px-3 py-1.5 text-sm text-gray-100 placeholder-gray-500 focus:outline-none focus:border-indigo-500"
                />
              </div>
              <div class="flex gap-3">
                <button
                  phx-click="kalafiornia_verify_pin"
                  disabled={@kalafiornia_sending}
                  class="px-3 py-1.5 text-xs font-medium bg-indigo-600 hover:bg-indigo-500 disabled:opacity-50 text-white rounded-lg"
                >
                  <%= if @kalafiornia_sending, do: "Verifying…", else: "Verify" %>
                </button>
                <button
                  phx-click="kalafiornia_cancel"
                  class="px-3 py-1.5 text-xs font-medium text-gray-400 hover:text-gray-200"
                >
                  Cancel
                </button>
              </div>
            </div>
        <% end %>
      </div>
    </div>
  </div>
</Layouts.app>
